# AriaAI 生产环境配置模板
# 复制此文件为 .env 并填写实际值

# 数据库配置
DATABASE_URL=postgresql://postgres:密码@服务器IP:5432/ariaai

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=your-super-secret-jwt-key-here

# 管理员账号
ADMIN_EMAIL=admin@aria.d2cgo.co
ADMIN_PASSWORD=your-secure-admin-password

# CORS 配置（多个域名用逗号分隔）
CORS_ORIGINS=https://aria.d2cgo.co,https://www.aria.d2cgo.co

# 可选：环境标识
ENVIRONMENT=production

# 可选：日志级别
LOG_LEVEL=INFO
