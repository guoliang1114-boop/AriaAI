# AriaAI Backend Environment Example
# Copy this file to .env and fill in environment-specific values.
# Never commit real passwords, API keys, JWT secrets, or production database URLs.

# Database
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME"

# Security
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRATION_HOURS=24
ALLOW_INSECURE_JWT_SECRET=false

# Admin seed account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="replace-with-a-strong-password"

# LLM provider defaults
DEFAULT_LLM_PROVIDER=claude
DEFAULT_MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=1.0

# Optional provider base URL overrides
ANTHROPIC_BASE_URL=https://api.anthropic.com

# API keys should be injected by environment/secret manager or configured in UI.
# ANTHROPIC_API_KEY=
# MOONSHOT_API_KEY=
# BIGMODEL_API_KEY=
# MIMO_API_KEY=
# DEEPSEEK_API_KEY=

# CORS
# For local development, list explicit origins when credentials are enabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Feature flags
ENABLE_BIGMODEL=true
ENABLE_RAG=true
ENABLE_FILE_GENERATION=true

# Provider-neutral Agent Harness context budgeting. Models whose names include
# an explicit window (for example `*-8k`) override the default automatically.
DEFAULT_CONTEXT_WINDOW_TOKENS=32768
CONTEXT_WINDOW_SAFETY_MARGIN_PERCENT=8
CONTEXT_HISTORY_SUMMARY_TOKENS=1024
MODEL_TURN_MAX_ATTEMPTS=2
MODEL_TURN_RETRY_BASE_DELAY_MS=500
MODEL_TURN_RETRY_MAX_DELAY_MS=5000
# Maximum concurrent calls in an explicitly parallel-safe read batch.
# The Agent Harness clamps this value to 1..8; writes always remain serial.
TOOL_PARALLEL_MAX_CONCURRENCY=4
# Shared Agent Loop stopping boundaries. The harness clamps these to
# 1..16 steps, 1..64 planned tool calls, and 30..1800 seconds.
AGENT_TURN_MAX_STEPS=8
AGENT_TURN_MAX_TOOL_CALLS=24
AGENT_TURN_TIMEOUT_SECONDS=600

# Optional comma-separated absolute Skill roots, highest priority first.
# The repository's bundled skills/ root remains the final fallback.
# ARIA_SKILL_ROOTS=/opt/aria/skills,/srv/company/skills

# Scheduler
SCHEDULER_ENABLED=true

# Logging
LOG_LEVEL=INFO
