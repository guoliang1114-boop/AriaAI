# Server-only example. DO NOT commit a filled copy or share a key with iOS.
# Product activation, billing authorization, exact resource IDs and speaker are owner prerequisites.
VOICE_ENABLED=false
VOICE_API_KEY=
VOICE_ASR_RESOURCE_ID=
VOICE_TTS_RESOURCE_ID=
VOICE_SPEAKER=
# Leave false until an authorized sample confirms dedicated TTS PCM16LE mono 24kHz.
VOICE_TTS_PCM_LAYOUT_CONFIRMED=false
# Application ceilings, not supplier quotas or price commitments.
VOICE_MAX_SESSION_SECONDS=300
VOICE_MAX_IDLE_SECONDS=30
VOICE_MAX_RESPONSE_SECONDS=120
VOICE_MAX_UTTERANCE_SECONDS=60
VOICE_MAX_AUDIO_BYTES=9600000
VOICE_MAX_TEXT_CHARACTERS=12000
VOICE_MAX_CONCURRENT_SESSIONS=1
VOICE_DAILY_AUDIO_SECONDS=1800
VOICE_DAILY_TTS_CHARACTERS=60000
